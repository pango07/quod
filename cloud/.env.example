# Quod Cloud (app.quodci.com). Copy to .env.local and fill in. Never commit real values.
#
# Sign-in: WorkOS AuthKit. Set all four or none.
# - None set and NODE_ENV is not "production" (npm run dev): a local demo session
#   with sample data. Nothing to sign up for.
# - In production all four are required; the server refuses to start or serve without them.

# WorkOS dashboard > API Keys. Needed for teams, members, invitations and the Admin Portal.
WORKOS_API_KEY=
# WorkOS dashboard > API Keys (client ID, starts with client_).
WORKOS_CLIENT_ID=
# At least 32 characters; encrypts the session cookie. Generate: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=
# Must match a redirect URI in WorkOS dashboard > Redirects.
#   local:      http://localhost:3000/callback
#   production: https://app.quodci.com/callback
NEXT_PUBLIC_WORKOS_REDIRECT_URI=

# Data: quod-server (protocol quod.v1, not built yet). Unset: the built-in sample data,
# which production serves only with QUOD_API=fixture set on purpose.
QUOD_API_URL=
# QUOD_API=fixture

# Optional: slow every sample-data call down (milliseconds) to see the loading states.
# QUOD_FIXTURE_DELAY_MS=600
