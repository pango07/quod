# Quod Cloud (app.quodci.com). Copy to .env.local and fill in. Never commit real values.
#
# Sign-in: WorkOS AuthKit. Set all four or none.
# - `npm run dev` loads .env.development (committed), which sets QUOD_AUTH=demo and
#   QUOD_API=fixture: a local demo session with sample data, nothing to sign up for.
#   A complete WorkOS config in .env.local takes precedence over the demo flag.
# - Everywhere else the four WorkOS values are required. `next start` refuses to boot
#   without them, and production never runs the demo, even with QUOD_AUTH=demo.

# WorkOS dashboard > API Keys. Needed for teams, members, invitations and the Admin Portal.
WORKOS_API_KEY=
# WorkOS dashboard > API Keys (client ID, starts with client_).
WORKOS_CLIENT_ID=
# At least 32 characters; encrypts the session cookie. Generate: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=
# Must match a redirect URI in WorkOS dashboard > Redirects.
#   local:      http://localhost:3000/callback
#   production: https://app.quodci.com/callback
# NEXT_PUBLIC_* values are inlined into the build: either leave this unset when you run
# `next build` and set it only at runtime, or build with exactly the runtime value.
# A different value at build time and at runtime breaks sign-in.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=

# Local demo session (development only; ignored when the four WorkOS values are set).
# QUOD_AUTH=demo

# Quod's data (replays, trust, savings). GitHub's data does not depend on it.
# - unset: no Quod server; teams see their GitHub CI and "Appears once Quod runs".
# - QUOD_API=http: quod-server (quod.v1) at QUOD_SERVER_URL (https; http only for
#   localhost or a private .internal host). See docs/api.md "Go-live".
# - QUOD_API=fixture: the built-in sample data, on purpose only (.env.development sets it).
# QUOD_API=http
# Not secret. quod-server's base URL.
# QUOD_SERVER_URL=https://quod-server.example.com
# Secret. While quod-server has only static viewer tokens: WorkOS org id -> its team and
# viewer token, e.g. {"org_01H...":{"team":"acme","token":"..."}}.
# QUOD_SERVER_TEAMS=
# Not secret. "workos": send the viewer's WorkOS access token (once quod-server verifies them).
# QUOD_SERVER_VIEWER_AUTH=workos

# Sample data only: QUOD_SIMULATE=0 stops the simulated live CI runs on the sample team.
# QUOD_SIMULATE=0

# Optional: slow every sample-data call down (milliseconds) to see the loading states.
# QUOD_FIXTURE_DELAY_MS=600

# ---- GitHub App (README "GitHub App setup"). Live CI status needs all of these.
# Postgres. On Vercel the Neon integration sets both. Locally, a PGlite folder:
#   npm run db:migrate -- --pglite ./.pglite   then   DATABASE_URL=pglite:./.pglite
# Secret. Pooled URL, used by the app.
DATABASE_URL=
# Secret. Direct URL, used only by `npm run db:migrate`.
DATABASE_URL_UNPOOLED=
# The public origin, for the App's URLs. Unset: the request's origin (localhost works).
APP_URL=
# Who may open /setup/github-app (comma-separated sign-in emails). Not secret.
QUOD_OPERATOR_EMAILS=
# From /setup/github-app/callback, shown once. ID, SLUG and CLIENT_ID are not secret;
# CLIENT_SECRET, WEBHOOK_SECRET and PRIVATE_KEY are. Never stored in the database.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=
# The whole PEM, newlines included (a one-line value with literal \n also works).
GITHUB_APP_PRIVATE_KEY=
# Secret, at least 16 characters (openssl rand -hex 32). Vercel Cron sends it to
# /api/github/reconcile (daily), which redelivers failed webhooks and heals stuck runs.
CRON_SECRET=
