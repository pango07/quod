# The step rootfs: the filesystem every memoized step runs in, pinned by
# content. Debian slim by OCI digest, the packages cli/cli's tests need (git,
# ssh-keygen, CA certificates) from a Debian snapshot at a fixed time, and
# the pinned Go toolchain (COPYed in after a sha256 check). Built by
# scripts/build-rootfs.sh, which exports the filesystem and imports it with
# `quod rootfs import`; the digest it prints is what the step key's
# `image` field pins. Nothing in here is ever read from the host at run time.
ARG BASE_DIGEST
FROM debian:bookworm-slim@${BASE_DIGEST}
ARG APT_SNAPSHOT
# A deliberately different rootfs for the miss test: extra packages.
ARG EXTRA_PKGS=""
RUN set -eu; \
    printf 'Types: deb\nURIs: http://snapshot.debian.org/archive/debian/%s\nSuites: bookworm bookworm-updates\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n\nTypes: deb\nURIs: http://snapshot.debian.org/archive/debian-security/%s\nSuites: bookworm-security\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n' \
      "$APT_SNAPSHOT" "$APT_SNAPSHOT" > /etc/apt/sources.list.d/debian.sources; \
    echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99snapshot; \
    echo 'Acquire::Retries "5";' >> /etc/apt/apt.conf.d/99snapshot; \
    apt-get update; \
    apt-get install -y --no-install-recommends git openssh-client ca-certificates $EXTRA_PKGS; \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/* /var/log/* /var/cache/ldconfig/aux-cache /var/cache/debconf/*-old
COPY go.tgz /tmp/go.tgz
RUN tar -C /usr/local -xzf /tmp/go.tgz && rm /tmp/go.tgz
RUN mkdir -p /workspace
