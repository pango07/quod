# Linux dev box for the 0a spike. Run privileged with /dev/fuse:
#   scripts/dev.sh <command>
FROM debian:bookworm
ARG GO_VERSION
ARG RUST_TOOLCHAIN
ARG NODE_VERSION
ARG PYTHON_VERSION
ARG PBS_RELEASE
ARG UV_VERSION
RUN apt-get update && apt-get install -y --no-install-recommends \
      bubblewrap ca-certificates curl fuse3 git build-essential pkg-config \
      sqlite3 util-linux procps time openssh-client \
    && rm -rf /var/lib/apt/lists/*
RUN arch=$(dpkg --print-architecture) \
    && curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-${arch}.tar.gz" | tar -C /usr/local -xz
ENV PATH=/usr/local/cargo/bin:/usr/local/go/bin:/usr/local/node/bin:/usr/local/python/bin:/usr/local/uv/bin:$PATH \
    RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal \
      --default-toolchain "${RUST_TOOLCHAIN}" -c rustfmt -c clippy
RUN echo user_allow_other >> /etc/fuse.conf
# Node (pinned LTS) at /usr/local/node, Python (pinned, a
# python-build-standalone release) at /usr/local/python and uv (pinned, the
# lockfile installer Python repos use) at /usr/local/uv: toolchains for the
# polyglot corpus. All sit under /usr, which the sandbox binds read-only,
# and all are hashed into the host fingerprint like go.
RUN arch=$(dpkg --print-architecture) \
    && case "$arch" in arm64) narch=arm64; triple=aarch64-unknown-linux-gnu;; amd64) narch=x64; triple=x86_64-unknown-linux-gnu;; *) exit 1;; esac \
    && curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${narch}.tar.gz" | tar -C /usr/local -xz \
    && mv "/usr/local/node-v${NODE_VERSION}-linux-${narch}" /usr/local/node \
    && curl -fsSL "https://github.com/astral-sh/python-build-standalone/releases/download/${PBS_RELEASE}/cpython-${PYTHON_VERSION}+${PBS_RELEASE}-${triple}-install_only_stripped.tar.gz" | tar -C /usr/local -xz \
    && mkdir -p /usr/local/uv/bin \
    && curl -fsSL "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-${triple}.tar.gz" | tar -C /usr/local/uv/bin -xz --strip-components=1 \
    && node --version && npm --version && python3 --version && uv --version
WORKDIR /src
